# CloudNotes backend environment variables
# Copy to `backend/.env` and fill in real values. NEVER commit .env.

# --- Database ---------------------------------------------------------------
# Primary (intended full-stack) configuration: MySQL.
# Replace USER, PASSWORD, HOST, PORT, DATABASE with your own values.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/cloudnotes?charset=utf8mb4

# Optional TEST configuration used ONLY by pytest when set.
# Tests default to a private temporary SQLite file when this is unset.
# SQLite is never used as the production database.
# TEST_DATABASE_URL=sqlite:///C:/path/to/temp/test.db

# --- Flask ------------------------------------------------------------------
# Use a long random value in production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# development | testing | production
FLASK_ENV=development

# --- Sessions ---------------------------------------------------------------
# Server-side session lifetime in hours (cookie is HttpOnly; no tokens in JS).
SESSION_HOURS=168

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (no spaces).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Rate limiting ----------------------------------------------------------
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=300

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
