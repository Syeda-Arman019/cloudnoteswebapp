[TEMPLATE]
# CloudNotes frontend environment variables
# Copy this file to `.env` and adjust the values for your environment.
# VITE_ prefixed variables are exposed to the browser bundle.

# Base URL of the CloudNotes REST API (Flask backend, Part 2).
#
# Recommended for local development — same-origin via the Vite dev proxy
# (`/api` is forwarded to http://127.0.0.1:5000, see vite.config.js):
#   VITE_API_URL=/api
#
# Direct (cross-origin) backend URL also works — the backend allows the
# dev origins in CORS_ORIGINS and the session cookie is sent with
# `credentials: 'include'`:
#   VITE_API_URL=http://127.0.0.1:5000/api
#   VITE_API_URL=https://api.cloudnotes.example.com/api
#
# Leave empty to run the frontend in DEMO MODE (browser-only store, no
# network requests). Demo mode exists in DEVELOPMENT builds only — when
# VITE_API_URL is unset in a production build, requests go to the same
# origin and the real API is always expected; there is no demo fallback.
VITE_API_URL=/api

# Optional: override the dev proxy target for the Vite server
# (used by `npm run dev`; default http://127.0.0.1:5000).
# VITE_PROXY_TARGET=http://127.0.0.1:5000
